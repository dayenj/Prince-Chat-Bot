if __name__ == "__main__":
    # তোমার বট আইডির লগইন ইমেইল এবং পাসওয়ার্ড নিচে বসিয়ে রান করবে
    BOT_EMAIL = "YOUR_BOT_EMAIL_HERE"
    BOT_PASSWORD = "YOUR_BOT_PASSWORD_HERE"

    print(f"[{BOT_NAME}] Starting Bot Service...")
    print(f"Target Bot ID: {BOT_ID}")
    print(f"Main Admin (Sayem): {ADMIN_1_ID}")
    print(f"Second Admin: {ADMIN_2_ID}")

    client = BVCSZBot(BOT_EMAIL, BOT_PASSWORD)
    print("Bot is Active & Listening...")
    client.listen()



